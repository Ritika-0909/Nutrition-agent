# ============================================================
# NutriAgent AI - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control

# --- Flask Core ---
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite:///nutriagent.db
# MySQL (for production, uncomment and fill)
# DATABASE_URL=mysql+pymysql://username:password@host:3306/nutriagent

# --- IBM Watsonx.ai ---
IBM_API_KEY=NkwXl9LLnyyhdlSVRyJHKi-IqLznpgmjuS8-HB5Av3IB
IBM_PROJECT_ID=25fcf521-9b38-4bbb-b244-3ec28b7ed4dc
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --- IBM Granite Model ---
GRANITE_MODEL_ID=ibm/granite-4-h-small
# Alternatives: ibm/granite-3b-code-instruct, ibm/granite-20b-multilingual

# --- AI Generation Parameters ---
MAX_NEW_TOKENS=1200
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50
REPETITION_PENALTY=1.1

# --- Email (Flask-Mail, optional) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=NutriAgent AI <your-email@gmail.com>

# --- Security ---
JWT_SECRET_KEY=another-secret-key-for-jwt
BCRYPT_LOG_ROUNDS=12
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_DURATION=2592000

# --- Feature Flags ---
ENABLE_MULTILINGUAL=True
ENABLE_PDF_EXPORT=True
ENABLE_MEAL_REMINDERS=True
ENABLE_FAMILY_PROFILES=True
DEFAULT_LANGUAGE=en

# --- Rate Limiting ---
RATELIMIT_DEFAULT=100 per hour
AI_RATELIMIT=20 per hour
